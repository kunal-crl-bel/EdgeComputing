<config>
    <!-- Mode, production/debugging/development -->
    <mode>debug</mode>
    <!-- For video Input -->
    <video_source>/dev/video0</video_source>

    <!-- Model Path -->
    <model_path>/home/kunal/Projects/BSS/TrainedModels/03June2025/best.pt</model_path>

    <!-- Detection Threshould -->
    <detect_confidence>0.5</detect_confidence>

    <!-- Image Similarity -->
    <db_dir>./images/crop_db</db_dir>
    <max_db_size_mb>500</max_db_size_mb>

    <similarity_threshold>10</similarity_threshold>
    <cooldown_seconds>5</cooldown_seconds>

    <parallel_workers_similarity>4</parallel_workers_similarity>
    <parallel_workers_io>4</parallel_workers_io>
    <parallel_workers_udp_msg>4</parallel_workers_udp_msg>

    <prefetch_input_stream_frame>5</prefetch_input_stream_frame>

    <!-- Frame Output dir -->
    <saved_frame_dir>./images/saved_frames</saved_frame_dir>

    <!-- Host info for UDP packet. -->
    <udp_ip>127.0.0.1</udp_ip>
    <udp_port>5100</udp_port>

    <!-- For Live stream  -->
    <live_stream_dst_ip>127.0.0.1</live_stream_dst_ip>
    <live_stream_dst_port>5004</live_stream_dst_port>
    <live_stream_bitrate_kbps>500</live_stream_bitrate_kbps>
    <live_stream_fps>12</live_stream_fps>
    <live_stream_height>350</live_stream_height>
    <live_stream_width>500</live_stream_width>

    <src_csci_id>5</src_csci_id>
    <dest_csci_id>1</dest_csci_id>
    <src_unit_id>0</src_unit_id>
    <dest_unit_id>2</dest_unit_id>
    <msg_id>3</msg_id>

    <!-- Tracker -->
    <tracker_config>/home/kunal/Projects/BSS/yolo-env/lib/python3.12/site-packages/ultralytics/cfg/trackers/bytetrack.yaml</tracker_config>

    <srs_values_of_classes>
        <PERSON>10</PERSON>
        <VEHICLE>12</VEHICLE>
    </srs_values_of_classes>

</config>
